|> Bootcamp
    title=Components Playground
    handle=playground
    page-necessary-margin=270
    max-element-width=1200


    |> Exercises
        handle=playground-exercises


        |> Exercise
            handle=grid-component

            |> ExerciseStatement
                What is the Grid component ?
            |> Solution
                _*Grid*_ used for putting items in a controlled grid layout, a more friendly alternative to Table component that needs all special html tags tr, colgroup ...etc

                |> Pause

                _*Case 1:*_ 3 cols, 2 on mobile, place-items="start"

                |> Grid
                    cols=3
                    mobile-cols=2
                    place-items=start

                    Item 1

                    Item 2

                    Item 3

                    Item 4

                    Item 5

                    Item 6

                |> Pause

                _*Case 2:*_ 3 cols, place-items="center" (default)

                |> Grid
                    cols=3

                    Short

                    Medium text

                    A longer piece of text

                    Item 4

                    Item 5

                    Item 6

                |> Pause

                _*Case 3:*_ 3 cols, place-items="end"

                |> Grid
                    cols=3
                    place-items=end

                    Short

                    Medium text

                    A longer piece of text

                    Item 4

                    Item 5

                    Item 6

                |> Pause

                _*Case 4:*_ 2 cols, column-first=true (fills top-to-bottom)

                |> Grid
                    cols=2
                    column-first=true
                    place-items=start

                    1st

                    2nd

                    3rd

                    4th

                    5th

                    6th

                |> Pause

                _*Case 5:*_ 2 cols, column-first=false (default, fills left-to-right)

                |> Grid
                    cols=2
                    place-items=start

                    1st

                    2nd

                    3rd

                    4th

                    5th

                    6th

                |> Pause

                _*Case 6:*_ with-padding=false

                |> Grid
                    cols=3
                    with-padding=false
                    place-items=start

                    Item 1

                    Item 2

                    Item 3

                    Item 4

                    Item 5

                    Item 6

                |> Pause

                _*Case 7:*_ custom gap="2rem"

                |> Grid
                    cols=3
                    gap=2rem
                    place-items=start

                    Item 1

                    Item 2

                    Item 3

                    Item 4

                    Item 5

                    Item 6

                |> Pause

                _*Case 8:*_ custom gap="0.25rem"

                |> Grid
                    cols=3
                    gap=0.25rem
                    place-items=start

                    Item 1

                    Item 2

                    Item 3

                    Item 4

                    Item 5

                    Item 6

                |> Pause

                _*Case 9:*_ margin-top=40, margin-bottom=40

                |> Grid
                    cols=3
                    margin-top=40
                    margin-bottom=40
                    place-items=start

                    Item 1

                    Item 2

                    Item 3

                    Item 4

                    Item 5

                    Item 6

                |> Pause

                _*Case 10:*_ custom mobile-cutoff=800 (switches to mobile layout at 800px)

                |> Grid
                    cols=4
                    mobile-cols=2
                    mobile-cutoff=800
                    place-items=start

                    Item 1

                    Item 2

                    Item 3

                    Item 4

                    Item 5

                    Item 6

                    Item 7

                    Item 8

                |> Pause

                _*Case 11:*_ overflow row (5 items in 3 cols)

                |> Grid
                    cols=3
                    place-items=start

                    Item 1

                    Item 2

                    Item 3

                    Item 4

                    Item 5

                |> Pause

                _*Case 12:*_ column-first + mobile-cols (2 cols desktop, 1 on mobile)

                |> Grid
                    cols=2
                    mobile-cols=1
                    column-first=true
                    place-items=start
                    with-padding=false

                    1st

                    2nd

                    3rd

                    4th

                |> Pause

                _*Case 13:*_ custom style (light pink background)

                |> Grid
                    cols=3
                    place-items=start
                    style=background-color:#ffe4e6

                    Item 1

                    Item 2

                    Item 3

                    Item 4

                    Item 5

                    Item 6

                |> Pause

                _*Case 14:*_ 3 cols, 2 on mobile, mobile-cutoff=520, center-on-overflow=true (from >>_true_false_)

                |> Grid
                    cols=3
                    mobile-cols=2
                    mobile-cutoff=520
                    center-on-overflow=true

                    a. $0.9^2 < 0.9$

                    b. $\sqrt{0.01} = 0.1$

                    c. $\sqrt[2]{\up{0.8}\sqrt[3]{2}} = \sqrt[3]{\up{0.8}\sqrt[2]{2}}$

                    d. ${\sqrt{2} \over \up{0.55}2} = \sqrt{0.5}$

                    e. ${1 \over \sqrt{2}} = \sqrt{0.5}$

                    f. $2^{30} > 1000^3$

                    g. ${1 \over 0.95} > 1.05$

                    h. $(-1)^{101} = -1$

                    i. ${100 \over \up{0.5}99} < {101 \over \up{0.5}100}$

                |> Pause

                _*Case 15:*_ 3 cols, place-items=end (from >>_true_false_)

                |> Grid
                    cols=3
                    place-items=end

                    $ (-1)^1 = $

                    $ (-1) = $

                    $ -1 $

                    $ (-1)^2 = $

                    $ (-1)\times (-1) = $

                    $ 1 $

                    $ (-1)^3 = $

                    $ (-1)\times(-1)\times (-1) = $

                    $ -1 $

                    $ (-1)^4 = $

                    $ (-1)\times(-1)\times(-1)\times(-1) = $

                    $ 1 $

                    $ (-1)^5 = $

                    $ \,\,\,(-1)\times(-1)\times(-1)\times(-1)\times(-1) = $

                    $ -1 $

                |> Pause

                _*Case 16:*_ 2 cols, 1 on mobile, place-items=start, with-padding=false, column-first=true (from >>_evaluate_lambda_functions_)

                |> Grid
                    cols=2
                    mobile-cols=1
                    place-items=start
                    with-padding=false
                    column-first=true

                    i. $(\lambda u.u^3)(0.5)$

                    ii. $(u \ra u^2)(x + 1)$

                    iii. $(\lambda t.t - 1)(100) \cdot (\lambda t.t + 1)(100)$

                    iv. $(u \ra u^2)(a + b)$

                |> Pause

                _*Case 17:*_ same as Case 16, 4 items only (from >>_evaluate_lambda_functions_)

                |> Grid
                    cols=2
                    mobile-cols=1
                    place-items=start
                    with-padding=false
                    column-first=true

                    i. $0.5^3 = 0.125$

                    ii. $(x + 1)^2 = x^2 + 2x + 1$

                    iii. $(100 - 1) \cdot (100 + 1) = 9999$

                    iv. $(a + b)^2 = a^2 + 2ab + b^2$

                |> Pause

                _*Case 18:*_ 2 cols, 1 on mobile, center-on-overflow=true, place-items=start, with-padding=false, column-first=true (from >>_true_or_false_composition_questions_)

                |> Grid
                    cols=2
                    mobile-cols=1
                    center-on-overflow=true
                    place-items=start
                    with-padding=false
                    column-first=true

                    i. $f \circ g = (x \ra f(g(x)))$

                    ii. $g \circ f = (x \ra f(g(x)))$

                    iii. $f \circ g = (x \ra g(f(x)))$

                    iv. $g \circ f = (x \ra g(f(x)))$

        |> Exercise
            handle=image-component

            |> ExerciseStatement
                What is the Image component ?

            |> Solution
                _*Image*_ renders an image centered in the main text column. On load it should be _constrained_ (fits the screen width, padded), and its _scale_ (current width ÷ original width) must be known _immediately on load_.

                |> Pause

                _*Debug colors*_ (background shows through the alpha test images):

                |> List
                    |> Item
                        dark red = constrained && scale &lt; 1
                    |> Item
                        light red = constrained && scale == 1
                    |> Item
                        light blue = not constrained && scale == 1
                    |> Item
                        green = not constrained && scale &lt; 1 (should be impossible)

                |> Pause

                _*Case 1:*_ set width=1000px, native 350px

                |> NewImage
                    src=images/test_native_350.svg
                    width=1000px

                |> Pause

                _*Case 2:*_ set width=1000px, native 1000px

                |> NewImage
                    src=images/test_native_1000.svg
                    width=1000px

                |> Pause

                _*Case 3:*_ set width=350px, native 1000px

                |> NewImage
                    src=images/test_native_1000.svg
                    width=350px

                |> Pause

                _*Case 4:*_ set width=350px, native 350px

                |> NewImage
                    src=images/test_native_350.svg
                    width=350px

