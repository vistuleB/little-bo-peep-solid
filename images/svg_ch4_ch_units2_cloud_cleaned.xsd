<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.w3.org/2000/svg">
      <xs:element name="svg">
            <xs:complexType>
                  <xs:sequence>
                        <xs:element name="namedview">
                              <xs:complexType>
                                    <xs:attribute name="id" use="required" />
                                    <xs:attribute name="pagecolor" use="required" />
                                    <xs:attribute name="bordercolor" use="required" />
                                    <xs:attribute name="borderopacity" type="xs:decimal"
                                          use="required" />
                              </xs:complexType>
                        </xs:element>
                        <xs:element name="path" maxOccurs="unbounded">
                              <xs:complexType>
                                    <xs:attribute name="style" use="required" />
                                    <xs:attribute name="d" use="required" />
                                    <xs:attribute name="id" type="xs:ID" use="required" />
                              </xs:complexType>
                        </xs:element>
                        <xs:element name="g" maxOccurs="unbounded">
                              <xs:complexType>
                                    <xs:sequence>
                                          <xs:element name="path" maxOccurs="unbounded">
                                                <xs:complexType>
                                                      <xs:attribute name="style" use="required" />
                                                      <xs:attribute name="d" use="required" />
                                                      <xs:attribute name="id" type="xs:ID"
                                                            use="required" />
                                                </xs:complexType>
                                          </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="id" use="required" />
                                    <xs:attribute name="transform" />
                              </xs:complexType>
                        </xs:element>
                        <xs:element name="image">
                              <xs:complexType>
                                    <xs:attribute name="width" type="xs:decimal" use="required" />
                                    <xs:attribute name="height" type="xs:decimal" use="required" />
                                    <xs:attribute name="x" type="xs:decimal" use="required" />
                                    <xs:attribute name="y" type="xs:decimal" use="required" />
                                    <xs:attribute name="preserveAspectRatio" use="required" />
                                    <xs:attribute name="id" use="required" />
                              </xs:complexType>
                        </xs:element>
                  </xs:sequence>
                  <xs:attribute name="width" type="xs:integer" use="required" />
                  <xs:attribute name="height" type="xs:integer" use="required" />
                  <xs:attribute name="version" type="xs:decimal" use="required" />
                  <xs:attribute name="id" use="required" />
            </xs:complexType>
      </xs:element>
</xs:schema>